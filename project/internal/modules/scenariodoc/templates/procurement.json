      "style": "reluctant",
      "on_reveal": { "change": { "trust": 3 } }
    },
    {
      "id": "cash_gap",
      "label": "У Сергея кассовый разрыв к концу месяца",
      "text": "Сергею нужно закрыть платёж по кредиту до конца месяца — отсюда такая настойчивость с предоплатой.",
