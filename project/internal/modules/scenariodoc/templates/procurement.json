      "id": "walkout",
      "label": "Уход",
      "terminal": true,
      "directive": { "goal": "Вежливо завершить разговор без сделки.", "allowed_intents": ["leave"], "forbidden": [], "tactics": [] },
      "may_reveal": [],
      "fillers": ["Что ж."],
      "fallback_lines": ["Тогда не договорились."]
