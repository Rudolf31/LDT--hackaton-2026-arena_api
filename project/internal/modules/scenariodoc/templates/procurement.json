  "evidence_weights": {
    "competitor_quote": 1.0,
    "market_price": 0.8,
    "past_contract": 0.7,
    "spec_document": 0.6,
    "third_party": 0.5,
    "policy_rule": 0.4,
    "own_constraint": 0.3,
    "opinion": 0.1,
    "none": 0
  },
  "move_effects": [
    { "id": "greet_once", "move": "greet", "once": true, "change": { "trust": 3 } },
    { "id": "probe_problem_trust", "move": "probe_problem", "change": { "trust": 4 } },
    {
      "id": "alternative_with_figure",
      "move": "state_alternative",
      "if": { "argument": { "concrete": true }, "scope": "this_reply" },
      "change": { "credibility": 10, "pressure": 10 }
    },
    {
      "id": "alternative_without_figure",
      "move": "state_alternative",
      "if": { "argument": { "concrete": false }, "scope": "this_reply" },
      "change": { "credibility": -15, "pressure": 5 },
      "set_flags": ["bluff_suspected"]
    },
    {
      "id": "prepay_trade",
      "if": { "offer": "payment", "side": "participant", "scope": "this_reply", "op": "is", "value": "prepay_100" },
      "once": true,
      "change": { "trust": 5, "credit": 40 },
      "set_flags": ["prepay_offered"]
    },
    {
      "id": "criteria_with_figure",
      "move": "justify_with_criteria",
      "if": { "argument": { "concrete": true }, "scope": "this_reply" },
      "change": { "credibility": 8, "pressure": -5 },
      "clear_flags": ["bluff_suspected"]
    },
    { "id": "insult_penalty", "move": "insult", "change": { "trust": -12, "pressure": 10, "patience": -3 } },
    { "id": "walkout_threat_pressure", "move": "walkout_threat", "change": { "pressure": 15, "trust": -5 } }
  ],
  "start_stage": "opening",
