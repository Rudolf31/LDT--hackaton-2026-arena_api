# Копируйте в .env и заполните. Переменные без значения по умолчанию
# обязательны — без них портал (или Postgres при первом запуске) не стартует.

# --- Postgres (только для docker-compose, роль-владелец) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=arena

# Пароль роли arena_app — задаёт его этот файл, не db/schema/arena-db.sql
# (arena-portal-backend-architecture.md 11.1).
ARENA_APP_PASSWORD=

# --- Портал (arena-portal-backend-architecture.md 11.2) ---
# ARENA_DATABASE_URL для docker-compose собирается из POSTGRES_DB и
# ARENA_APP_PASSWORD выше; при запуске портала не в compose задайте отдельно:
# ARENA_DATABASE_URL=postgres://arena_app:<пароль>@localhost:5432/arena?sslmode=disable

# Мастер-ключ шифрования: base64, ровно 32 байта после декодирования (D-15).
# Сгенерировать: openssl rand -base64 32
ARENA_MASTER_KEY=

# Секрет HMAC кодов доступа, токенов и ссылок на репетицию: тот же формат.
# Сгенерировать: openssl rand -base64 32
ARENA_CODE_HMAC_SECRET=

# Адрес и порт HTTP. По умолчанию :8080.
ARENA_LISTEN=:8080

# Авторство сценария голосом и текстом (этап 05, D-34/D-35) — обе модели
# через github.com/revrost/go-openrouter (D-13, D-32); ключа и адреса
# OpenRouter в этом репозитории нет — заполните своими, если хотите
# проверить вживую, тесты идут на двойниках и без них.

# Модель, которая собирает документ сценария по описанию/указанию.
# ARENA_GEN_KEY и ARENA_GEN_MODEL включают генерацию — без них все четыре
# адреса авторства отвечают 503. ARENA_GEN_URL можно не задавать — по
# умолчанию облако OpenRouter (https://openrouter.ai/api/v1).
ARENA_GEN_URL=
ARENA_GEN_KEY=
ARENA_GEN_MODEL=

# Расшифровка надиктованного описания/указания. ARENA_STT_MODEL включает
# расшифровку — без неё два голосовых адреса (generation/audio,
# draft/voice-edit) отвечают 503, текстовые не затронуты.
# ARENA_STT_KEY/ARENA_STT_URL можно не задавать — по умолчанию берутся из
# ARENA_GEN_KEY/ARENA_GEN_URL выше (один ключ OpenRouter на обе модели).
ARENA_STT_URL=
ARENA_STT_KEY=
ARENA_STT_MODEL=

# Демо-режим. По умолчанию включён; выключение — одна эта переменная (FR-AC-09).
ARENA_DEMO=true

# Выдавать ли гостям демо ключи моделей. Только на стенде жюри, по умолчанию
# выключено.
DEMO_MODEL_KEYS=false

# Уровень лога.
ARENA_LOG_LEVEL=info

# Флаг Secure у cookie входа в портал (D-22). По умолчанию включён; на стенде
# без HTTPS поставьте false — иначе браузер не вернёт cookie и вход не
# сработает (http://localhost браузеры считают безопасным и так).
ARENA_COOKIE_SECURE=true

# Адрес клиента-тренажёра: из него строится ссылка на код доступа при
# назначении — <адрес>/t?code=ARENA-… (D-53). По умолчанию http://localhost:5173.
ARENA_TRAINER_URL=
